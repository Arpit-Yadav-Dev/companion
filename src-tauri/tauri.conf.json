{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Companion",
  "version": "0.1.0",
  "identifier": "com.companion.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../packs/aura/": "packs/aura/",
      "../packs/bao/": "packs/bao/",
      "../packs/bolt/": "packs/bolt/",
      "../packs/buzz/": "packs/buzz/",
      "../packs/flex/": "packs/flex/",
      "../packs/hop/": "packs/hop/",
      "../packs/luna/": "packs/luna/",
      "../packs/mochi/": "packs/mochi/",
      "../packs/nimbus/": "packs/nimbus/",
      "../packs/pip/": "packs/pip/",
      "../packs/scout/": "packs/scout/",
      "../packs/sip/": "packs/sip/",
      "../packs/sprout/": "packs/sprout/",
      "../packs/sunny/": "packs/sunny/"
    }
  }
}